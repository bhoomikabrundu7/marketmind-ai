# Backend Configuration
PROJECT_NAME="MarketMind AI REST API"
SECRET_KEY="your-production-super-secret-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Connection (SQLite default, PostgreSQL for Docker/Prod)
DATABASE_URL="sqlite:///./marketmind.db"

# CORS Allowed Origins (Comma separated string or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js Environment Variables
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"